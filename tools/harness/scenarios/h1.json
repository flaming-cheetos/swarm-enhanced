{
  "id": "H1",
  "title": "Gather oak_log x1 with evidence",
  "priority": "P0",
  "requires": ["bridge", "panel"],
  "steps": [
    { "action": "taskClearDone", "as": "cleared" },
    { "action": "taskAdd", "item": "oak_log", "qty": 1, "type": "GATHER", "bot": "any", "as": "added" },
    { "action": "waitForTask", "item": "oak_log", "status": "COMPLETE", "timeoutSec": 10, "as": "task" },
    { "action": "logs", "as": "taskLogs" },
    { "action": "state", "as": "state" },
    { "action": "screenshot", "as": "screenshot", "file": "h1-screenshot.png" }
  ],
  "assert": [
    { "path": "task.status", "equals": "COMPLETE" },
    { "path": "task.reason", "equals": "" },
    { "path": "taskLogs", "contains": "completed" },
    { "path": "state.inGame", "equals": true }
  ]
}
